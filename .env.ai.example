# ─────────────────────────────────────────────────────────────────────────────
# AI Service Configuration  —  .env.ai.example
#
# Copy to .env.ai and fill in your values.
# docker-compose.infra.yml reads this file automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Whisper STT ────────────────────────────────────────────────────────────────
# Model options: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
# large-v3-turbo is the default — fastest with near large-v3 accuracy (~3.1GB VRAM)
WHISPER_MODEL=large-v3-turbo

# float16    → best on CUDA (RTX 4060)
# int8_float16 → lower VRAM, slight quality drop
# int8       → CPU fallback
WHISPER_COMPUTE_TYPE=float16

# ── Kokoro TTS ────────────────────────────────────────────────────────────────
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_DEFAULT_LANG=a
KOKORO_DEFAULT_SPEED=1.0

# ── MinIO (S3-compatible storage for call recordings) ─────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKETS=call-recordings,file-uploads

# ── Ollama (native — accessed via host.docker.internal from containers) ────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Valkey / Redis (native — used by Celery, sessions, rate limiting) ─────────
# Already set in main .env; copy here if running infra compose standalone
REDIS_URL=redis://localhost:6379/0
