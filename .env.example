# ─── App ───────────────────────────────────────────────────────────────────
APP_NAME=SaaS Platform
ENVIRONMENT=development          # development | staging | production
DEBUG=true
APP_VERSION=1.0.0

# ─── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Security ──────────────────────────────────────────────────────────────
# Generate Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-with-Fernet.generate_key
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Storage ───────────────────────────────────────────────────────────────
STORAGE_PROVIDER=s3              # s3 | local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
LOCAL_STORAGE_PATH=/tmp/uploads

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com