# Backend API base URL (no trailing slash, no /api/v1)
# Dev default: Vite proxy handles /api automatically → set to empty
VITE_API_URL=http://localhost:8000/api/v1

# App environment
VITE_APP_ENV=development

# Feature flags override (optional)
VITE_ENABLE_DEVTOOLS=true

# Stripe publishable key (client-side tokenization only — never the secret key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
